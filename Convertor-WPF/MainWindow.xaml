<Window x:Class="Convertor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Convertor"
        mc:Ignorable="d"
        Title="Convertor" Height="500" Width="800">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Country" HorizontalAlignment="Center"/>
            
            <ComboBox x:Name="ComboBoxCountry" SelectedIndex="0" Margin="0,5,0,0">
                <ComboBoxItem Content="Not selected"/>
                <ComboBoxItem Content="USA"/>
                <ComboBoxItem Content="Other"/>
            </ComboBox>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Initial data" HorizontalAlignment="Center"/>

                <TextBlock Text="Unit of measurement" Margin="0,5,0,0"/>
                <ComboBox x:Name="ComboBoxUnitOfMeasurement" Margin="0,5,0,0"/>

                <TextBlock Text="Value" Margin="0,5,0,0"/>
                <TextBox x:Name="TextBoxValue" Margin="0,5,0,0"/>
            </StackPanel>

            <Grid Grid.Column="1">
                <Button Click="ButtonConvert_Click" Width="150" Height="75" Content="Convert to" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse Fill="LightBlue" StrokeThickness="2"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Result" HorizontalAlignment="Center"/>

                <TextBlock Text="To unit of measurement" Margin="0,5,0,0"/>
                <ComboBox x:Name="ComboBoxToUnitOfMeasurement" Margin="0,5,0,0"/>

                <TextBlock Text="To value" Margin="0,5,0,0"/>
                <TextBox x:Name="TextBoxToValue" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
