<Window x:Class="Grid_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Grid_WPF"
        mc:Ignorable="d"
        Title="Grid" Height="350" Width="650">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="30" />
		</Grid.RowDefinitions>

		<!-- 0 -->
		<Grid Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="100" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Rectangle Grid.Column="0" Fill="#4F4F4F" />
			<Rectangle Grid.Column="1" Fill="#7C7C7C" />

			<TextBlock x:Name="TextBlock0_0" Grid.Column="0" Text="Width=100" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" />
			<TextBlock x:Name="TextBlock0_1" Grid.Column="1" Text="Width=*" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" />
		</Grid>

		<!-- 1 -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="100" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Rectangle Grid.Column="0" Fill="#4F4F4F" />
			<Rectangle Grid.Column="1" Fill="#7C7C7C" />
			<Rectangle Grid.Column="2" Fill="#B1B1B1" />
			<Rectangle Grid.Column="3" Fill="#4F4F4F" />

			<TextBlock x:Name="TextBlock1_0" Grid.Column="0" Text="Width=100" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" />
			<TextBlock x:Name="TextBlock1_1" Grid.Column="1" Text="Width=*" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" />
			<TextBlock x:Name="TextBlock1_2" Grid.Column="2" Text="Width=*" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" />
			<TextBlock x:Name="TextBlock1_3" Grid.Column="3" Text="Width=*" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" />
		</Grid>

		<!-- 2 -->
		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="100" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Rectangle Grid.Column="0" Fill="#4F4F4F" />
			<Rectangle Grid.Column="1" Fill="#7C7C7C" />
			<Rectangle Grid.Column="2" Fill="#B1B1B1" />
			<Rectangle Grid.Column="3" Fill="#4F4F4F" />

			<TextBlock x:Name="TextBlock2_0" Grid.Column="0" Text="Width=100" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" />
			<TextBlock x:Name="TextBlock2_1" Grid.Column="1" Text="Width=*" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" />
			<TextBlock x:Name="TextBlock2_2" Grid.Column="2" Text="Width=2*" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" />
			<TextBlock x:Name="TextBlock2_3" Grid.Column="3" Text="Width=*" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" />
		</Grid>
		
		<!-- 3 -->
		<Grid Grid.Row="3">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="100" />
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="4*" />
				<ColumnDefinition Width="2*" />
			</Grid.ColumnDefinitions>
			<Rectangle Grid.Column="0" Fill="#4F4F4F" />
			<Rectangle Grid.Column="1" Fill="#7C7C7C" />
			<Rectangle Grid.Column="2" Fill="#B1B1B1" />
			<Rectangle Grid.Column="3" Fill="#4F4F4F" />

			<TextBlock x:Name="TextBlock3_0" Grid.Column="0" Text="Width=100" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" />
			<TextBlock x:Name="TextBlock3_1" Grid.Column="1" Text="Width=2*" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" />
			<TextBlock x:Name="TextBlock3_2" Grid.Column="2" Text="Width=4*" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" />
			<TextBlock x:Name="TextBlock3_3" Grid.Column="3" Text="Width=2*" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" />
		</Grid>

		<!-- Button -->
		<Grid Grid.Row="4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!-- Remove text button -->
			<Button Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Click="RemoveTextButton">
				Remove text
			</Button>

			<!-- Restore text button -->
			<Button Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Click="RestoreTextButton">
				Restore text
			</Button>
		</Grid>
	</Grid>
</Window>
